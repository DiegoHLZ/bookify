POSTGRES_DB=bookify
POSTGRES_USER=bookify
POSTGRES_PASSWORD=change-me-for-local-development

BOOKIFY_DB_PORT=5433
BOOKIFY_DB_URL=jdbc:postgresql://localhost:5433/bookify
BOOKIFY_DB_USERNAME=bookify
BOOKIFY_DB_PASSWORD=change-me-for-local-development
BOOKIFY_JWT_SECRET=replace-with-at-least-32-random-bytes
BOOKIFY_JWT_EXPIRATION_MS=86400000
BOOKIFY_SERVER_PORT=8080

# Optional NVIDIA semantic-search experiment. Never commit a real key.
NVIDIA_API_KEY=
BOOKIFY_NVIDIA_EMBEDDING_URL=https://integrate.api.nvidia.com/v1/embeddings
BOOKIFY_NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
BOOKIFY_NVIDIA_RERANKING_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-1b-v2/reranking
BOOKIFY_NVIDIA_RERANKING_MODEL=nvidia/llama-nemotron-rerank-1b-v2
BOOKIFY_SEMANTIC_ENABLED=false
BOOKIFY_SEMANTIC_PROVIDER=mock
BOOKIFY_SEMANTIC_TIMEOUT_MS=5000

# Opt-in only for the live evaluation test; request cost is optional because NVIDIA pricing
# depends on the selected hosting/account agreement.
BOOKIFY_RUN_NVIDIA_LIVE=false
BOOKIFY_NVIDIA_COST_PER_1000_REQUESTS_USD=
